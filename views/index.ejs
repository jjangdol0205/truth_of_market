<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Truth of Market - 글로벌 테크 밸류체인 외신 브리핑</title>
  <!-- SEO 메타 태그 -->
  <meta name="description" content="자율주행, 로봇, 우주, 크립토, 원전 5대 핵심 산업과 Nvidia, Tesla, Rocket Lab 등 69개 글로벌 선도 기업의 최신 외신을 AI로 분석하는 투자 리서치 플랫폼.">
  <link rel="canonical" href="https://truthofmarket.com/" />
  <!-- RSS 피드 -->
  <link rel="alternate" type="application/rss+xml" title="Truth of Market 인사이트 피드" href="https://truthofmarket.com/feed.xml" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content="Truth of Market - 글로벌 테크 밸류체인 외신 브리핑" />
  <meta property="og:description" content="자율주행, 로봇, 우주, 크립토, 원전 5대 산업 및 69개 글로벌 기업의 최신 외신 AI 분석 대시보드." />
  <meta property="og:url" content="https://truthofmarket.com/" />
  <meta property="og:site_name" content="Truth of Market" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Truth of Market - 글로벌 테크 밸류체인 외신 브리핑" />
  <meta name="twitter:description" content="자율주행, 로봇, 우주, 크립토, 원전 5대 산업 및 69개 글로벌 기업의 최신 외신 AI 분석 대시보드." />
  <!-- Schema.org JSON-LD 구조화 데이터 -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "NewsMediaOrganization",
        "@id": "https://truthofmarket.com/#organization",
        "name": "Truth of Market",
        "url": "https://truthofmarket.com",
        "email": "contact@truthofmarket.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://truthofmarket.com/icon-192.png",
          "width": 192,
          "height": 192
        },
        "description": "국내외 주요 언론사 실시간 경제 뉴스를 수집하고 AI 분석을 활용하여 투자 시사점을 제공하는 투자 연구 플랫폼입니다."
      },
      {
        "@type": "WebSite",
        "@id": "https://truthofmarket.com/#website",
        "url": "https://truthofmarket.com",
        "name": "Truth of Market",
        "publisher": { "@id": "https://truthofmarket.com/#organization" },
        "inLanguage": "ko-KR",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://truthofmarket.com/?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
  </script>
  <% if (typeof gscId !== 'undefined' && gscId) { %>
  <meta name="google-site-verification" content="<%= gscId %>" />
  <% } %>
  
  <% if (typeof adsenseClientId !== 'undefined' && adsenseClientId) { %>
  <!-- Google AdSense 심사용 자동 광고 스크립트 -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsenseClientId %>" crossorigin="anonymous"></script>
  <% } %>
  
  <!-- 구글 폰트 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- 폰트어썸 아이콘 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- 커스텀 CSS -->
  <link rel="stylesheet" href="styles.css">
  
  <!-- PWA (모바일 앱 홈화면 추가) 설정 -->
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#090d16">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Truth of Market">
  <link rel="apple-touch-icon" href="icon-192.png">
</head>
<body class="dark-theme">
  <!-- 배경 그라디언트 요소들 -->
  <div class="bg-glow bg-glow-1"></div>
  <div class="bg-glow bg-glow-2"></div>
  <div class="bg-glow bg-glow-3"></div>

  <!-- 전체 레이아웃 컨테이너 -->
  <div class="app-container">
    
    <!-- 1. 헤더 (Navbar) -->
    <header class="app-header">
      <div class="logo-container" id="logoContainer" title="홈화면으로 이동">
        <div class="logo-icon"><i class="fa-solid fa-chart-line"></i></div>
        <div class="logo-text">
          <h1>TRUTH OF<span class="highlight">MARKET</span></h1>
          <span class="sub-logo">AI Study & News Briefing</span>
        </div>
      </div>

      <!-- 실시간 시황 티커 (Yahoo Finance API 연동) -->
      <div class="market-ticker-container">
        <div class="ticker-wrapper" id="marketTicker">
          <div class="ticker-item"><span class="ticker-label">KOSPI</span> <span class="ticker-val up">8,109.13 ▲ 7.89%</span></div>
          <div class="ticker-item"><span class="ticker-label">NASDAQ</span> <span class="ticker-val up">26,343.97 ▲ 0.45%</span></div>
          <div class="ticker-item"><span class="ticker-label">S&P 500</span> <span class="ticker-val up">7,473.47 ▲ 0.88%</span></div>
          <div class="ticker-item"><span class="ticker-label">원/달러</span> <span class="ticker-val down">1,506.28 ▼ 0.10%</span></div>
          <div class="ticker-item"><span class="ticker-label">국제유가(WTI)</span> <span class="ticker-val down">91.86 ▼ 6.51%</span></div>
          <div class="ticker-item"><span class="ticker-label">미 10년물 국채</span> <span class="ticker-val down">4.558% ▼ 2.34%</span></div>
        </div>
      </div>

      <!-- 헤더 우측 메뉴 -->
      <div class="header-actions">
        <div class="search-box">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="searchInput" placeholder="투자 키워드 검색 (예: 금리, AI, 엔비디아)...">
        </div>
        <button id="themeToggle" class="icon-btn" title="테마 변경"><i class="fa-solid fa-moon"></i></button>
        <button id="settingsBtn" class="icon-btn" title="설정"><i class="fa-solid fa-gear"></i></button>
      </div>
    </header>

    <!-- 2. 본문 컨텐츠 레이아웃 -->
    <main class="app-content">
      
      <!-- 2.1 좌측 사이드바 (필터 & 텔레그램 컨트롤) -->
      <aside class="app-sidebar">
        
        <!-- 네비게이션 섹션 -->
        <nav class="sidebar-nav">
          <h3 class="nav-title"><i class="fa-solid fa-satellite-dish"></i> 팔로잉 필터</h3>
          <ul class="nav-list">
            <li class="nav-item active" data-filter="curated" id="nav-curated">
              <i class="fa-solid fa-crown" style="color: hsl(var(--accent-gold));"></i> <span>오늘의 핵심 30선</span>
            </li>
            <li class="nav-item" data-filter="all" id="nav-all">
              <i class="fa-solid fa-newspaper"></i> <span>전체 외신 피드</span>
            </li>
          </ul>

          <!-- 5대 산업 필터 -->
          <h3 class="nav-title" style="margin-top: 16px;"><i class="fa-solid fa-industry"></i> 5대 핵심 산업</h3>
          <ul class="nav-list" id="industryFilterList">
            <li class="nav-item" data-filter="following-autonomous" data-industry="autonomous" id="nav-autonomous">
              🚗 <span>자율주행</span>
            </li>
            <li class="nav-item" data-filter="following-robotics" data-industry="robotics" id="nav-robotics">
              🤖 <span>로봇/자동화</span>
            </li>
            <li class="nav-item" data-filter="following-space" data-industry="space" id="nav-space">
              🚀 <span>우주/방산</span>
            </li>
            <li class="nav-item" data-filter="following-crypto" data-industry="crypto" id="nav-crypto">
              ₿ <span>크립토/블록체인</span>
            </li>
            <li class="nav-item" data-filter="following-nuclear" data-industry="nuclear" id="nav-nuclear">
              ⚡ <span>전력/원전/에너지</span>
            </li>
            <li class="nav-item" data-filter="following-power-infra" data-industry="power-infra" id="nav-power-infra">
              🔌 <span>전력인프라</span>
            </li>
          </ul>

          <h3 class="nav-title" style="margin-top: 16px;"><i class="fa-solid fa-pen-nib"></i> 오리지널 칼럼</h3>
          <ul class="nav-list">
            <li class="nav-item" style="padding: 0;">
              <a href="/insights" style="color: inherit; text-decoration: none; display: flex; align-items: center; width: 100%; padding: 10px 12px; gap: 12px;">
                <i class="fa-solid fa-newspaper" style="color: hsl(var(--accent-gold));"></i> <span>시장 인사이트 칼럼</span>
              </a>
            </li>
          </ul>

          <h3 class="nav-title" style="margin-top: 16px;"><i class="fa-solid fa-bookmark"></i> 스터디 아카이브</h3>
          <ul class="nav-list">
            <li class="nav-item" data-filter="bookmarks" id="nav-bookmarks">
              <i class="fa-solid fa-book-bookmark"></i> <span>보관한 AI 학습노트</span>
            </li>
          </ul>

          <h3 class="nav-title" style="margin-top: 16px;"><i class="fa-solid fa-circle-info"></i> 신뢰 센터</h3>
          <ul class="nav-list">
            <li class="nav-item" style="padding: 0;">
              <a href="/about" style="color: inherit; text-decoration: none; display: flex; align-items: center; width: 100%; padding: 10px 12px; gap: 12px;">
                <i class="fa-solid fa-address-card"></i> <span>운영자 및 플랫폼 소개</span>
              </a>
            </li>
            <li class="nav-item" style="padding: 0;">
              <a href="/contact" style="color: inherit; text-decoration: none; display: flex; align-items: center; width: 100%; padding: 10px 12px; gap: 12px;">
                <i class="fa-solid fa-envelope"></i> <span>제안 및 버그 문의</span>
              </a>
            </li>
          </ul>
        </nav>

        <!-- AI 비서 스터디 공유 패널 -->
        <div class="sidebar-card share-panel">
          <div class="share-panel-header">
            <h4><i class="fa-solid fa-share-nodes" style="color: hsl(var(--accent-cyan));"></i> 스터디 공유 비서</h4>
            <span class="status-dot active" id="shareStatus">준비완료</span>
          </div>
          <p class="kakao-desc">실시간 AI 학습 노트를 카카오톡이나 텔레그램으로 편리하게 내보내 보세요.</p>
          
          <!-- 카카오톡 복사 버튼 -->
          <button id="sendKakaoBriefingBtn" class="kakaotalk-btn pulse-effect" style="width: 100%; justify-content: center; border: none; padding: 12px; font-size: 0.92rem; margin-bottom: 8px;">
            <i class="fa-solid fa-copy"></i> 카카오톡 브리핑 복사
          </button>
          
          <!-- 텔레그램 복사 버튼 -->
          <button id="sendTgBriefingBtn" class="telegram-btn" style="width: 100%; justify-content: center; border: none; padding: 12px; font-size: 0.92rem;">
            <i class="fa-solid fa-copy"></i> 텔레그램 브리핑 복사
          </button>
        </div>

        <!-- 퀵 노트 위젯 -->
        <div class="sidebar-card study-tip-panel">
          <h4><i class="fa-solid fa-graduation-cap"></i> 투자 학습 가이드</h4>
          <ul class="study-tips">
            <li>영문 금융 뉴스는 <strong>AI 스터디</strong>를 클릭하면 고품격 한글 번역과 투자 요약본을 제공합니다.</li>
            <li>정기 스터디를 위해 관심 있는 기사를 보관함에 담고 텔레그램 채널에 스터디 그룹원들과 공유하세요.</li>
          </ul>
        </div>

        <!-- [애드센스 대응] 사이드바 광고 영역 플레이스홀더 -->
        <div class="sidebar-card adsense-sidebar-placeholder">
          <div class="adsense-label">SPONSORED ADVERTISEMENT</div>
          <div class="adsense-box">
            <i class="fa-solid fa-rectangle-ad"></i>
            <p>PREMIUM SPONSOR</p>
            <span>Sponsor Inquiry</span>
          </div>
        </div>
      </aside>

      <!-- 2.2 메인 뉴스 그리드 리스트 -->
      <section class="main-news-section">
        <div class="section-header">
          <h2 id="currentCategoryTitle">🌐 글로벌 테크 밸류체인 외신 브리핑</h2>
          <div class="news-meta-controls">
            <span class="article-count" id="articleCount">로딩 중...</span>
            <button id="refreshNewsBtn" class="refresh-btn"><i class="fa-solid fa-arrows-rotate"></i> 새로고침</button>
          </div>
        </div>

        <!-- 기업 칩 필터 영역 (동적으로 채워짐) -->
        <div id="companyChipContainer" class="company-chip-container" style="display:none;">
          <div class="chip-scroll-wrapper">
            <button class="company-chip active" data-company-id="all" id="chip-all">전체 보기</button>
            <!-- JS가 following-config.json 기반으로 동적 생성 -->
          </div>
        </div>

        <!-- [애드센스 대응] 메인 상단 리더보드 가로형 광고 플레이스홀더 -->
        <div class="adsense-banner-placeholder">
          <div class="adsense-banner-label">ADVERTISEMENT</div>
          <div class="adsense-banner-content">
            <i class="fa-solid fa-rectangle-ad animate-sparkle"></i>
            <div class="adsense-banner-text">
              <h5>PREMIUM SPONSOR & ADVERTISEMENT</h5>
              <p>본 플랫폼은 양질의 글로벌 AI 투자 스터디 및 뉴스 브리핑 서비스를 무상으로 제공하기 위해 공식 파트너 스폰서십 및 제휴 광고 게재를 준비하고 있습니다.</p>
            </div>
            <span class="banner-badge">Sponsor Inquiry (제휴 문의)</span>
          </div>
        </div>

        <!-- 뉴스 로딩 스피너 -->
        <div class="loading-container" id="newsLoading">
          <div class="spinner"></div>
          <p>실시간 언론사 경제 및 투자 RSS 피드를 가져오는 중입니다...</p>
        </div>

        <!-- 에러 메시지 뷰 -->
        <div class="error-container hidden" id="newsError">
          <i class="fa-solid fa-triangle-exclamation"></i>
          <p>뉴스 데이터를 가져오는 도중 문제가 발생했습니다.</p>
          <button id="errorRetryBtn" class="retry-btn">다시 시도</button>
        </div>

        <!-- 빈 뉴스 목록 안내 -->
        <div class="empty-container hidden" id="newsEmpty">
          <i class="fa-solid fa-folder-open"></i>
          <p id="emptyMessage">표시할 투자 뉴스가 없습니다.</p>
        </div>

        <!-- 실제 뉴스 카드가 배치될 그리드 -->
        <div class="news-grid" id="newsGrid">
          <% if (typeof articles !== 'undefined' && articles && articles.length > 0) { %>
            <% articles.forEach(function(art) { 
                 const isEn = art.lang === 'en';
                 const flag = isEn ? '🇺🇸 US' : '🇰🇷 KR';
                 let timeString = '';
                 if (art.date) {
                   const d = new Date(art.date);
                   const now = new Date();
                   const diffMs = now - d;
                   const diffMins = Math.floor(diffMs / 60000);
                   const diffHours = Math.floor(diffMs / 3600000);
                   if (diffMins < 60) timeString = diffMins + '분 전';
                   else if (diffHours < 24) timeString = diffHours + '시간 전';
                   else timeString = d.toLocaleDateString('ko-KR');
                 } else {
                   timeString = '방금 전';
                 }
                 // following 산업/기업 태그
                 const industryMap = { autonomous: '🚗', robotics: '🤖', space: '🚀', crypto: '₿', nuclear: '⚡' };
                 const industryEmoji = art.followingIndustry ? (industryMap[art.followingIndustry] || '') : '';
                 const tickerBadge = art.companyTicker ? art.companyTicker : '';
            %>
              <div class="news-card<%= art.followingIndustry ? ' following-card following-' + art.followingIndustry : '' %>" onclick="openAiStudyModal('<%= art.id %>')" data-industry="<%= art.followingIndustry || '' %>" data-companies="<%= (art.followingCompanyIds||[]).join(',') %>">
                <div class="news-card-header">
                  <span class="source-badge"><%= art.sourceName %></span>
                  <div style="display:flex; gap:4px; align-items:center;">
                    <% if (tickerBadge) { %>
                      <span class="ticker-badge">[<%= tickerBadge %>]</span>
                    <% } %>
                    <% if (industryEmoji) { %>
                      <span class="industry-emoji-badge"><%= industryEmoji %></span>
                    <% } %>
                    <span class="lang-flag"><%= flag %></span>
                  </div>
                </div>
                <h3><a href="/article/<%= art.id %>" onclick="event.stopPropagation();" style="color:inherit;text-decoration:none;" title="기사 상세 분석 페이지"><%= art.aiAnalysis && art.aiAnalysis.translatedTitle ? art.aiAnalysis.translatedTitle : art.title %></a></h3>
                <p class="news-card-desc"><%= art.description || '본문 요약이 없는 기사입니다. AI 스터디 기능을 활용하여 상세 정보를 번역하고 파악해보세요.' %></p>
                <div class="news-card-footer">
                  <span class="news-time"><i class="fa-regular fa-calendar-days"></i> <%= timeString %></span>
                  <div class="card-actions">
                    <a href="<%= art.link %>" target="_blank" class="card-btn original-btn" onclick="event.stopPropagation();" title="기사 원문 링크 열기">
                      <i class="fa-solid fa-arrow-up-right-from-square"></i> 원문 보기
                    </a>
                    <button class="card-btn bookmark-btn" onclick="event.stopPropagation(); toggleBookmark('<%= art.id %>')" title="보관함 저장">
                      <i class="fa-regular fa-star"></i>
                    </button>
                    <button class="card-btn ai-btn" onclick="openAiStudyModal('<%= art.id %>')">
                      <i class="fa-solid fa-wand-magic-sparkles"></i> AI 스터디
                    </button>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </section>
    </main>

    <!-- 3. 모달 레이어 모음 -->
    
    <!-- 3.1 AI 스터디 및 요약 팝업 모달 -->
    <div id="aiStudyModal" class="modal-overlay hidden">
      <div class="modal-card study-modal-card">
        <div class="modal-header">
          <div class="modal-title-wrap">
            <span class="modal-badge"><i class="fa-solid fa-wand-magic-sparkles animate-sparkle"></i> AI INVESTMENT STUDY NOTE</span>
            <h3 id="modalOriginalTitle">원본 기사 제목</h3>
          </div>
          <button class="close-modal-btn" onclick="closeModal('aiStudyModal')"><i class="fa-solid fa-xmark"></i></button>
        </div>
        
        <div class="modal-body">
          <!-- 기사 정보 바 -->
          <div class="modal-article-info">
            <span id="modalSource"><i class="fa-solid fa-newspaper"></i> 조선일보</span>
            <span id="modalDate"><i class="fa-regular fa-clock"></i> 2시간 전</span>
            <span id="modalLangBadge" class="lang-badge">KR</span>
          </div>

          <!-- 기사 내용 요약문 -->
          <div class="original-snippet-box">
            <h4><i class="fa-solid fa-align-left"></i> 기사 초안 / 본문 요약</h4>
            <p id="modalSnippet">기사 본문 내용 요약...</p>
          </div>

          <!-- AI 분석 로딩 영역 -->
          <div class="ai-loading-container" id="aiLoading">
            <div class="ai-spinner"></div>

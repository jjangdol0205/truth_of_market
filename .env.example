# 포트 설정
PORT=3000

# 구글 Gemini API 키 (Google AI Studio에서 무료 발급 가능)
# 발급처: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 텔레그램 봇 API 토큰 (@BotFather를 통해 생성)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 텔레그램 알림을 받을 수신자 Chat ID (개인 Chat ID 또는 그룹/채널 ID)
# 텔레그램 봇 검색창에서 '@userinfobot' 또는 봇과 대화하여 얻을 수 있습니다.
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 텔레그램 일일 투자 뉴스 자동 발송 스케줄 (기본값: 매일 오전 8시)
# 초 분 시 일 월 요일 (Cron 포맷)
CRON_SCHEDULE=0 8 * * *

# 구글 애드센스 게시자 클라이언트 ID (예: ca-pub-1234567890123456)
# 검토 승인을 위해 여기에 본인의 애드센스 ID를 입력해 두면 사이트의 헤더 영역에 자동으로 심사 코드가 연동됩니다.
ADSENSE_CLIENT_ID=

